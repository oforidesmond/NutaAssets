# Postgres (Neon / Vercel Postgres)
# DATABASE_URL = pooled connection (runtime)
# DIRECT_URL   = non-pooled (migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js
AUTH_SECRET="generate-a-long-random-string-at-least-32-chars"
AUTH_URL="http://localhost:3000"

# First-run Super Admin (prisma db seed)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMeNow1!"

# SMS (ebits) — optional locally; required to deliver credentials on user create/reset
SMS_PROVIDER="ebits"
EBITS_SMS_BASE_URL="https://alerts.ebitsgh.com"
EBITS_SMS_API_KEY=""
EBITS_SMS_SENDER_ID="Nwabiagya"

# Set to true only for CI builds that don't need live env validation
# SKIP_ENV_VALIDATION="true"
