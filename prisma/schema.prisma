generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  DEPT_ADMIN
  EDITOR
  VIEWER
}

enum BranchType {
  BRANCH
  HEAD_OFFICE
  DATA_CENTER
  OTHER
}

enum StatusKind {
  IN_USE
  NOT_IN_USE
  NEEDS_ATTENTION
  END_OF_LIFE
}

enum Condition {
  NEW
  GOOD
  FAIR
  POOR
}

enum FieldType {
  TEXT
  LONG_TEXT
  NUMBER
  DECIMAL
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
  EMAIL
  URL
  PHONE
}

enum AssetEventType {
  CREATED
  UPDATED
  STATUS_CHANGED
  TRANSFERRED
  ASSIGNED
  VERIFIED
  NOTE
  DISPOSED
  RESTORED
  DELETED
}

enum ReconciliationExerciseStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReconciliationEntryStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
}

enum ReconciliationResult {
  FOUND
  FOUND_DIFFERENT
  MISSING
  NEW_UNLISTED
}

enum ImportJobStatus {
  PENDING
  COMPLETED
  UNDONE
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  users           UserDepartment[]
  categories      Category[]
  fieldDefs       FieldDefinition[]
  statuses        Status[]
  assets          Asset[]
  reconciliations ReconciliationExercise[]
}

model Branch {
  id        String     @id @default(cuid())
  name      String     @unique
  code      String     @unique
  type      BranchType @default(BRANCH)
  address   String?
  isActive  Boolean    @default(true)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  locations Location[]
  users     UserBranch[]
  people    Person[]
  assets    Asset[]
  entries   ReconciliationEntry[]
}

model Location {
  id        String   @id @default(cuid())
  branchId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  branch Branch  @relation(fields: [branchId], references: [id])
  assets Asset[]

  @@unique([branchId, name])
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               Role      @default(VIEWER)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  departments         UserDepartment[]
  branches            UserBranch[]
  auditLogs           AuditLog[]
  assetEvents         AssetEvent[]
  createdAssets       Asset[]                 @relation("AssetCreatedBy")
  updatedAssets       Asset[]                 @relation("AssetUpdatedBy")
  importJobs          ImportJob[]
  preparedEntries     ReconciliationEntry[]   @relation("EntryPreparedBy")
  approvedEntries     ReconciliationEntry[]   @relation("EntryApprovedBy")
  createdExercises    ReconciliationExercise[] @relation("ExerciseCreatedBy")
  verifiedItems       ReconciliationItem[]    @relation("ItemVerifiedBy")
  savedViews          SavedView[]
}

model UserDepartment {
  id           String @id @default(cuid())
  userId       String
  departmentId String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
}

model UserBranch {
  id       String @id @default(cuid())
  userId   String
  branchId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
}

model Category {
  id           String   @id @default(cuid())
  departmentId String
  name         String
  code         String
  icon         String?
  parentId     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  department Department        @relation(fields: [departmentId], references: [id])
  parent     Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children   Category[]        @relation("CategoryHierarchy")
  assets     Asset[]
  fieldDefs  FieldDefinition[]

  @@unique([departmentId, name])
  @@unique([departmentId, code])
}

model Status {
  id           String     @id @default(cuid())
  departmentId String
  name         String
  color        String
  kind         StatusKind
  isDefault    Boolean    @default(false)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  department Department @relation(fields: [departmentId], references: [id])
  assets     Asset[]

  @@unique([departmentId, name])
}

model Person {
  id         String   @id @default(cuid())
  name       String
  staffId    String?
  email      String?
  phone      String?
  branchId   String?
  unitOrRole String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  branch Branch? @relation(fields: [branchId], references: [id])
  assets Asset[]
}

model Asset {
  id             String     @id @default(cuid())
  departmentId   String
  categoryId     String
  branchId       String
  locationId     String?
  assetTag       String?
  serialNumber   String?
  brand          String?
  model          String?
  statusId       String
  assignedToText String?
  assignedToId   String?
  purchaseDate   DateTime?
  purchaseCost   Decimal?   @db.Decimal(12, 2)
  warrantyExpiry DateTime?
  condition      Condition?
  remarks        String?
  customFields   Json       @default("{}")
  needsReview    Boolean    @default(false)
  reviewReasons  String[]   @default([])
  retiredAt      DateTime?
  deletedAt      DateTime?
  importJobId    String?
  createdById    String?
  updatedById    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  department        Department           @relation(fields: [departmentId], references: [id])
  category          Category             @relation(fields: [categoryId], references: [id])
  branch            Branch               @relation(fields: [branchId], references: [id])
  location          Location?            @relation(fields: [locationId], references: [id])
  status            Status               @relation(fields: [statusId], references: [id])
  assignedTo        Person?              @relation(fields: [assignedToId], references: [id])
  importJob         ImportJob?           @relation(fields: [importJobId], references: [id])
  createdBy         User?                @relation("AssetCreatedBy", fields: [createdById], references: [id])
  updatedBy         User?                @relation("AssetUpdatedBy", fields: [updatedById], references: [id])
  events            AssetEvent[]
  reconciliationItems ReconciliationItem[]

  @@index([departmentId, branchId, statusId])
  @@index([serialNumber])
  @@index([assetTag])
  @@index([assignedToText])
  @@index([needsReview])
  @@index([deletedAt])
  @@index([importJobId])
}

model FieldDefinition {
  id           String    @id @default(cuid())
  departmentId String
  categoryId   String?
  key          String
  label        String
  type         FieldType
  options      Json?
  required     Boolean   @default(false)
  unique       Boolean   @default(false)
  helpText     String?
  placeholder  String?
  defaultValue Json?
  showInList   Boolean   @default(false)
  searchable   Boolean   @default(true)
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  category   Category?  @relation(fields: [categoryId], references: [id])

  @@unique([departmentId, key])
}

model AssetEvent {
  id        String         @id @default(cuid())
  assetId   String
  type      AssetEventType
  fromValue Json?
  toValue   Json?
  note      String?
  userId    String?
  createdAt DateTime       @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id])

  @@index([assetId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model ReconciliationExercise {
  id             String                       @id @default(cuid())
  departmentId   String
  name           String
  startDate      DateTime
  endDate        DateTime?
  status         ReconciliationExerciseStatus @default(DRAFT)
  scopeBranchIds String[]
  notes          String?
  createdById    String?
  completedAt    DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  deletedAt      DateTime?

  department Department            @relation(fields: [departmentId], references: [id])
  createdBy  User?                 @relation("ExerciseCreatedBy", fields: [createdById], references: [id])
  entries    ReconciliationEntry[]
}

model ReconciliationEntry {
  id             String                    @id @default(cuid())
  exerciseId     String
  branchId       String
  preparedById   String?
  inventoryDate  DateTime?
  status         ReconciliationEntryStatus @default(NOT_STARTED)
  submittedAt    DateTime?
  approvedById   String?
  comment        String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  exercise   ReconciliationExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  branch     Branch                 @relation(fields: [branchId], references: [id])
  preparedBy User?                  @relation("EntryPreparedBy", fields: [preparedById], references: [id])
  approvedBy User?                  @relation("EntryApprovedBy", fields: [approvedById], references: [id])
  items      ReconciliationItem[]

  @@unique([exerciseId, branchId])
}

model ReconciliationItem {
  id           String                @id @default(cuid())
  entryId      String
  assetId      String?
  result       ReconciliationResult? // null = not yet verified (D32)
  observed     Json?
  note         String?
  verifiedById String?
  verifiedAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  entry      ReconciliationEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  asset      Asset?              @relation(fields: [assetId], references: [id])
  verifiedBy User?               @relation("ItemVerifiedBy", fields: [verifiedById], references: [id])

  @@index([entryId, result])
}

model ImportJob {
  id           String          @id @default(cuid())
  userId       String
  departmentId String?
  fileName     String
  mapping      Json
  totalRows    Int             @default(0)
  created      Int             @default(0)
  updated      Int             @default(0)
  skipped      Int             @default(0)
  flagged      Int             @default(0)
  errors       Json?
  status       ImportJobStatus @default(PENDING)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  assets Asset[]
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model SavedView {
  id           String   @id @default(cuid())
  userId       String
  departmentId String?
  name         String
  filters      Json
  columns      Json
  sort         Json?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, departmentId])
}
